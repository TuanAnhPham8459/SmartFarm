<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">


    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <!-- Header -->

        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="@string/device_control"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginStart="25dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

           </LinearLayout>





        <!-- Irrigation Pump -->

        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp">


            <LinearLayout
                android:gravity="center_vertical"
                android:background="?attr/colorSurface"
                android:padding="16dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <ImageView
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_irrigation_pump"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    tools:ignore="ContentDescription" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/irrigation_pump"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />


                    <TextView
                        android:id="@+id/tvPumpStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/on"
                        android:textColor="@color/status_ok"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                </LinearLayout>


                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchPump"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#4CAF50"
                    android:checked="true"
                    android:minWidth="48dp"
                    android:minHeight="48dp" />


            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>






        <!-- Cooling Fan -->

        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp">


            <LinearLayout
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="?attr/colorSurface"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <ImageView
                    android:src="@drawable/ic_cool_fan"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    tools:ignore="ContentDescription" />



                <LinearLayout
                    android:orientation="vertical"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="75dp">


                    <TextView
                        android:text="@string/cooling_fan"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>


                    <TextView
                        android:text="@string/off"
                        android:id="@+id/tvFanStatus"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>


                </LinearLayout>


                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchFan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:minWidth="48dp"
                    android:minHeight="48dp" />


            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>







        <!-- Grow Light -->

        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp">


            <LinearLayout
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="?attr/colorSurface"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <ImageView
                    android:src="@drawable/ic_light"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    tools:ignore="ContentDescription" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    tools:ignore="TextSizeCheck,TextSizeCheck">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grow_light"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />


                    <TextView
                        android:id="@+id/tvLightStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/on"
                        android:textColor="@color/status_ok"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                </LinearLayout>


                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minWidth="48dp"
                    android:minHeight="48dp" />


            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Auto Mode -->

        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="110dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp">


            <LinearLayout
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="?attr/colorSurface"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <ImageView
                    android:src="@drawable/ic_auto_mode"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    tools:ignore="ContentDescription" />


                <LinearLayout
                    android:orientation="vertical"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="75dp">


                    <TextView
                        android:text="@string/auto_mode"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>


                    <TextView
                        android:text="@string/devices_will_run_automatically_nbased_on_sensor_data"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>


                </LinearLayout>


                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minWidth="48dp"
                    android:minHeight="48dp" />


            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>



    </LinearLayout>

</ScrollView>