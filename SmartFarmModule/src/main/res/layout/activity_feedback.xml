<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/feedback"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_green" />
            </LinearLayout>

            <!-- Intro -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_intro"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_feedback_name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/full_name"
                app:startIconDrawable="@android:drawable/ic_menu_manage"
                app:startIconTint="@color/gray"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_feedback_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_feedback_email"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/email_hint"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                app:startIconTint="@color/gray"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_feedback_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_feedback_phone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/phone_hint"
                app:startIconDrawable="@android:drawable/ic_menu_call"
                app:startIconTint="@color/gray"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_feedback_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Category -->
            <TextView
                android:id="@+id/tv_feedback_category_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_category"
                android:textStyle="bold"
                android:textColor="@color/dark_green"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rg_feedback_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <RadioButton
                    android:id="@+id/rb_feature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feature_request" />

                <RadioButton
                    android:id="@+id/rb_ui"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_design_feedback" />

                <RadioButton
                    android:id="@+id/rb_general"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/general_feedback" />
            </RadioGroup>

            <TextView
                android:id="@+id/tv_category_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/required_field"
                android:textColor="@color/design_error_red"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="18dp" />

            <!-- Rating -->
            <TextView
                android:id="@+id/tv_feedback_rating_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_your_experience"
                android:textStyle="bold"
                android:textColor="@color/dark_green"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <RatingBar
                android:id="@+id/rating_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="0.5"
                android:rating="0" />

            <TextView
                android:id="@+id/tv_rating_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/required_field"
                android:textColor="@color/design_error_red"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="20dp" />

            <!-- Feedback Message -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_feedback_message"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/write_feedback"
                app:startIconDrawable="@android:drawable/ic_menu_edit"
                app:startIconTint="@color/gray"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_feedback_message"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minLines="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Submit button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit_feedback"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/submit_feedback"
                app:backgroundTint="@color/btn_submit_feedback_bg"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:cornerRadius="28dp" />

            <TextView
                android:id="@+id/tv_feedback_cooldown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/design_error_red"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                android:text="" />

        </LinearLayout>
    </ScrollView>

    <!-- Dimmed overlay + progress bar shown while submitting -->
    <FrameLayout
        android:id="@+id/overlay_submitting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:id="@+id/progress_feedback"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="260dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/dark_green" />

    </FrameLayout>

</FrameLayout>